# =============================================================================
# GLM-OCR 环境变量配置模板
# 复制此文件为 .env，填入真实值，不要提交 .env 到版本库
# copy .env.example .env
# =============================================================================


# =============================================================================
# 本地运行（复制后优先填写）
# =============================================================================

# 版面模型本地路径（推荐；不设则用 config.yaml 默认 Hugging Face id，需联网）
# 示例：D:/Desktop/GLM-OCR/models/PP-DocLayoutV3_safetensors
GLMOCR_LAYOUT_MODEL_DIR=

# ---- 自托管 OCR（Ollama / vLLM / SGLang）----
# 本机 Ollama 默认可不改；OCR 服务在其它机器时再改 host/port
# 连接方式二选一：
# 1) 配完整 URL（优先级更高）
#GLMOCR_OCR_API_URL=http://127.0.0.1:11434/api/generate
# 2) 或拆分 host/port/path
GLMOCR_OCR_API_HOST=127.0.0.1
GLMOCR_OCR_API_PORT=11434
GLMOCR_OCR_API_PATH=/api/generate
GLMOCR_OCR_API_MODE=ollama_generate
GLMOCR_OCR_MODEL=glm-ocr:latest
# Ollama 版本：本项目在 0.24.0 下验证；升级后 OCR 异常可回退
# https://github.com/ollama/ollama/releases/download/v0.24.0/OllamaSetup.exe

# ---- 批量处理路径（batch_process.py）----
# 输入文件夹：存放 {prefix}_question.png 和 {prefix}_answer.png 的目录
BATCH_INPUT_DIR=
# OCR / QA 输出（相对路径以 batch_process.py 所在目录为基准）
BATCH_OCR_OUTPUT_DIR=output
BATCH_QA_OUTPUT_DIR=qa_output
# 失败/跳过时的原图备份目录（每题一个子文件夹，含 reason.txt）
BATCH_ERROR_DIR=batch_error
# output / qa_output 最多保留题数；超出时按最旧优先删除整题（默认 500；-1 表示不删除）
BATCH_MAX_STORED_QUESTIONS=500


# =============================================================================
# LLM 审核器（启用时需填写 API Key）
# OCR 后对照原图做 insert / ocr_fix / dedup_fix / reorder 四类纠错
# =============================================================================

# 是否启用审核器（false 时完全跳过，可先关审核只跑 OCR）
LLM_REVIEWER_ENABLED=true

# OpenAI 兼容（vision）接口 base URL（不含 /chat/completions，仅到 /v1）
LLM_REVIEWER_BASE_URL=https://api.xiaomimimo.com/v1

# 对应平台的 API Key（启用审核时必填）
LLM_REVIEWER_API_KEY=

# 多模态模型名称（需支持 OpenAI vision 格式的 image_url 输入）
LLM_REVIEWER_MODEL=mimo-v2.5


# =============================================================================
# 调试与高级参数（一般保持默认，仅在排查问题时修改）
# =============================================================================

# ---- LLM 审核：多模态与请求 ----
# false 时退化为纯文本审核（不发图）
LLM_REVIEWER_MULTIMODAL=true
# 发图前等比缩放上限（长边像素）
LLM_REVIEWER_IMAGE_MAX_SIDE=1600
# 发图 JPEG 压缩质量（1-100）
LLM_REVIEWER_IMAGE_JPEG_QUALITY=85
# mimo-v2.5 不支持 response_format=json_object 时设为 false
LLM_REVIEWER_RESPONSE_FORMAT_JSON=true
# requests TLS 握手失败时，自动改用 curl.exe 发请求
LLM_REVIEWER_ENABLE_CURL_FALLBACK=true

# ---- LLM 审核：策略开关 ----
LLM_REVIEWER_ENABLE_OCR_FIX=true
LLM_REVIEWER_ENABLE_REORDER=true
LLM_REVIEWER_ENABLE_DEDUP_FIX=true
LLM_REVIEWER_ENABLE_INSERT=true
# 低于此置信度的修改不应用
LLM_REVIEWER_CONFIDENCE_THRESHOLD=0.8

# ---- LLM 审核：调用参数 ----
LLM_REVIEWER_TEMPERATURE=0
LLM_REVIEWER_MAX_TOKENS=8192
LLM_REVIEWER_TIMEOUT=120
LLM_REVIEWER_MAX_RETRIES=2
# 关闭 DeepSeek V4 thinking，避免 finish_reason=length 且 content 为空
LLM_REVIEWER_DISABLE_THINKING=true
