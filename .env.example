# =============================================================================
# GLM-OCR 环境变量配置模板
# 复制此文件为 .env，填入真实值，不要提交 .env 到版本库
# =============================================================================

# =============================================================================
# LLM 审核器（OCR后处理「看图校对」）
# 在 OCR 输出写入磁盘前，调用多模态 LLM 对照原图进行四类纠错：
#   1. 漏行补全（insert）
#   2. 识别错误纠错（ocr_fix，含角标/上下标补回）
#   3. 阅读顺序纠错（reorder）
#   4. 逻辑纠错 / 去重（ocr_fix / dedup_fix）
# 输入：带 bbox 的 raw_json + 对应页原图；输出：按 page+index 定位，不含 bbox
# =============================================================================

# 是否启用审核器（false 时完全跳过，保持原有行为）
LLM_REVIEWER_ENABLED=true

# ---- 模型接入 ----
# OpenAI 兼容（vision）接口 base URL（不含 /chat/completions，仅到 /v1）
LLM_REVIEWER_BASE_URL=https://api.xiaomimimo.com/v1

# 对应平台的 API Key
LLM_REVIEWER_API_KEY=

# 使用的多模态模型名称（需支持 OpenAI vision 格式的 image_url 输入）
# 例如：mimo-v2.5 / gpt-4o / qwen2.5-vl 等
LLM_REVIEWER_MODEL=mimo-v2.5

# ---- 多模态 ----
# 是否启用多模态（看图校对）。false 时退化为纯文本审核（不发图）
LLM_REVIEWER_MULTIMODAL=true

# 发图前等比缩放上限（长边像素），控成本/控 token
LLM_REVIEWER_IMAGE_MAX_SIDE=1600

# 发图 JPEG 压缩质量（1-100）
LLM_REVIEWER_IMAGE_JPEG_QUALITY=85

# 模型是否支持 response_format=json_object（mimo-v2.5 不支持时设为 false）
LLM_REVIEWER_RESPONSE_FORMAT_JSON=true

# requests 在当前环境 TLS 握手失败时，自动改用 curl.exe 发请求（推荐开启）
LLM_REVIEWER_ENABLE_CURL_FALLBACK=true

# ---- 审核策略 ----
# 是否启用识别错误纠错 / 角标补回（ocr_fix，任务2+任务4中的 ocr_fix）
LLM_REVIEWER_ENABLE_OCR_FIX=true

# 是否启用阅读顺序纠错（reorder，任务3）
LLM_REVIEWER_ENABLE_REORDER=true

# 是否启用切分重叠去重（dedup_fix，任务4）
LLM_REVIEWER_ENABLE_DEDUP_FIX=true

# 是否启用漏行补全（insert）
LLM_REVIEWER_ENABLE_INSERT=true

# ocr_fix / reorder / dedup_fix / insert 的置信度阈值（低于此值的修改不应用）
LLM_REVIEWER_CONFIDENCE_THRESHOLD=0.8

# ---- 调用参数 ----
# 温度（OCR 审核建议 0，输出最稳定）
LLM_REVIEWER_TEMPERATURE=0

# 最大输出 token 数
LLM_REVIEWER_MAX_TOKENS=8192

# 单次请求超时（秒）
LLM_REVIEWER_TIMEOUT=120

# 失败后最大重试次数（不含首次）
LLM_REVIEWER_MAX_RETRIES=2

# 关闭 DeepSeek V4 thinking，避免 finish_reason=length 且 content 为空
LLM_REVIEWER_DISABLE_THINKING=true


# =============================================================================
# 批量处理路径（batch_process.py）
# =============================================================================

# 输入文件夹：存放 {prefix}_question.png 和 {prefix}_answer.png 的目录
BATCH_INPUT_DIR=D:\Desktop\11

# OCR 输出文件夹：存放每张图片的识别结果（JSON、裁剪图片、版面可视化）
# 相对路径以 batch_process.py 所在目录为基准
BATCH_OCR_OUTPUT_DIR=output

# QA 输出文件夹：存放最终拼接好的 QA JSON 文件
BATCH_QA_OUTPUT_DIR=qa_output
